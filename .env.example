# ─── FAS 1050 Automat ─────────────────────────────
# IP und Port des Automaten im lokalen Netzwerk
VAS1050_HOST=X.X.X.X
VAS1050_PORT=8888
VAS1050_RECONNECT_DELAY=5

# ─── Telegram ─────────────────────────────────────
# Bot-Token von @BotFather (optional, für Benachrichtigungen)
VAS1050_TELEGRAM_BOT_TOKEN=dein_bot_token_hier

# Chat-ID der Zielgruppe (z.B. -1001234567890 für Gruppe)
VAS1050_TELEGRAM_CHAT_ID=deine_gruppen_chat_id_hier
